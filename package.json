{
  "name": "@txc2768651338/dsh-effort-slider",
  "description": "仿 Claude Code 推理等级滑块 DSH 插件：无极拖动、松手吸附、WebGL 火焰跟随、OFF/MAX 刻度、Low/Medium/High/Ultracode 状态；宿主侧通用思考强度供给——任何自定义第三方模型/提供商都能获得真实生效的思考强度调节。",
  "version": "0.5.1",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ],
      "platform": "web"
    }
  },
  "license": "BSD-3-Clause",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown --config ./tsdown.config.ts",
    "watch": "tsdown --config ./tsdown.config.ts --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node test/package-config.spec.mjs && node test/build-determinism.mjs && node test/host.spec.mjs",
    "test:live": "node test/live-profile.spec.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/cordis-plugin-group": "1.0.5",
    "@deepseek-ai/cordis-plugin-include": "1.0.10",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-model-selection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@types/node": "^24.13.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "immer": "^10.2.0",
    "jsdom": "^30.0.1",
    "lightningcss": "^1.33.0",
    "playwright": "^1.64.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1",
    "zustand": "~4.5.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/2768651338/dsh-effort-slider.git"
  },
  "homepage": "https://github.com/2768651338/dsh-effort-slider",
  "bugs": {
    "url": "https://github.com/2768651338/dsh-effort-slider/issues"
  }
}
